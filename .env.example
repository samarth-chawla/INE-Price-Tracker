# INE Tracker — environment template (repo root).
# Copy to `.env` and fill in values. Never commit `.env`.
#
# The backend loads this file first, then `backend/.env` as a fallback
# (existing local setups keep working).

# Supabase PostgreSQL connection string (IPv4-compatible pooler recommended).
# Dashboard → Connect → Session pooler → Connection string.
# URL-encode special characters in the password (e.g. # → %23).
SUPABASE_CONNECTION_STRING=postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Shared secret protecting POST /api/scrape/run (cron-job.org sends it as the
# `x-scrape-token` header). Generate a long random value. Anyone with this
# token can trigger scraping — do NOT confuse it with Supabase credentials.
SCRAPE_RUN_TOKEN=change-me-to-a-long-random-string

# Production: the deployed Vercel frontend origin (locks CORS).
# e.g. FRONTEND_URL=https://ine-tracker-frontend.vercel.app
# Leave unset for local dev (CORS open).
# FRONTEND_URL=

# Backend listen port (Render injects PORT; default 3001 locally).
# PORT=3001

# Optional: override the Playwright browser binary (local dev only).
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=C:/path/to/chrome.exe

# Demo only: PLAYWRIGHT_HEADED=1 opens a visible browser window via
# backend/demo-headed.js (production default is headless — leave unset).
# PLAYWRIGHT_HEADED=
